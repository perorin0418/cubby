# ctr-* スクリプトの設定。リモートホストの /etc/ctr/config.env に置く（実値はリポジトリに入れない）。
# 優先順位: /etc/ctr/config.env > 環境変数 > 下記の既定値
# ※ /etc/ctr/config.env は sh の文法で読み込まれる（. で source される）。

# 元リポジトリ（.git だけがコンテナにマウントされる）
CTR_REPO=/srv/project
# worktree の置き場
CTR_WT_ROOT=/srv/worktrees
# コンテナイメージ
CTR_IMAGE=ctr-dev:latest
# 全コンテナ共通のホスト鍵のディレクトリ（root 所有、秘密鍵は 600）
CTR_HOSTKEYS=/etc/ctr/hostkeys
# ユーザー名ごとの authorized_keys のディレクトリ（root 所有、644）
CTR_AUTHKEYS=/etc/ctr/authorized_keys
# 名前ごとの排他ロック
CTR_LOCK_DIR=/tmp/ctr-locks
