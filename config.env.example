# ctr-* スクリプトの設定。リモートホストの ~/.config/cubby/config.env に置く
# （cubby add-host / host/setup-host.sh が自動で作る。実値はリポジトリに入れない）。
# 優先順位: config.env > 環境変数 > 下記の既定値
# ※ sh の文法で読み込まれる（. で source される）。

# このホストの ID。接続名 ctr-<作業名>.<ID> の ID と一致しない接続は拒否する
CTR_HOST_ID=
# 元リポジトリ（.git だけがコンテナにマウントされる）。ログインユーザー所有であること
CTR_REPO=/srv/project
# worktree の置き場
CTR_WT_ROOT=/srv/worktrees
# コンテナイメージ
CTR_IMAGE=localhost/ctr-dev:latest
# 以下は通常変更しない（既定は config.env と同じディレクトリの下）
#CTR_HOSTKEYS=$HOME/.config/cubby/hostkeys
#CTR_AUTHKEYS=$HOME/.config/cubby/authorized_keys
#CTR_LOCK_DIR=$XDG_RUNTIME_DIR/cubby-locks
#CTR_BIN_DIR=$HOME/.local/bin
