# 参考: `cubby add-host lab1 --hostname lab1.example.com --user alice --cloudflared` が
# ~/.ssh/config の先頭に書く管理ブロック。通常は手で書く必要はない（再実行すると置き換わる）。
# コマンドは絶対パスで書かれる（GUI から起動した Claude Desktop は PATH が最小限のため）。
#
# macOS（Homebrew の cloudflared）の例:
# >>> cubby lab1 ssh-host=lab1 gpu=yes >>>
Host ctr-*.lab1 gpu-*.lab1
  User dev
  ProxyCommand /usr/bin/ssh lab1 .local/bin/ctr-connect %n
  HostKeyAlias cubby-lab1
  ServerAliveInterval 30
Host lab1
  HostName lab1.example.com
  User alice
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  ServerAliveInterval 30
# <<< cubby lab1 <<<

# Windows の例（Windows 標準の OpenSSH を使う。空白を含むパスは二重引用符で囲まれる）:
# >>> cubby lab1 ssh-host=lab1 gpu=yes >>>
# Host ctr-*.lab1 gpu-*.lab1
#   User dev
#   ProxyCommand C:/WINDOWS/System32/OpenSSH/ssh.exe lab1 .local/bin/ctr-connect %n
#   HostKeyAlias cubby-lab1
#   ServerAliveInterval 30
# Host lab1
#   HostName lab1.example.com
#   User alice
#   ProxyCommand "C:/Program Files (x86)/cloudflared/cloudflared.exe" access ssh --hostname %h
#   ServerAliveInterval 30
# <<< cubby lab1 <<<
#
# パターン（Host ctr-*.lab1）を解釈できない SSH クライアントでは、接続名ごとに
# 「Host ctr-feature1.lab1」のように書き分ける（中身は同じ）。
