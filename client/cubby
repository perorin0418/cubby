#!/bin/sh
# cubby : 手元の PC（Windows・macOS・Linux）から、リモートホスト（複数可）を登録・管理する。
# Windows では Git Bash で実行する（PowerShell・cmd からは cubby.ps1 / cubby.cmd）。
#
#   cubby add-host <id> [options]   リモートホストを登録し、ホストの環境を整える。登録の設定
#                                   （接続先・ユーザー・鍵など）を変えるときも、これを実行し直す
#       --hostname FQDN     ホストの実際の名前。指定すると ssh_config にホストの設定も書く
#       --user USER         ホストのログインユーザー（--hostname と一緒に使う）
#       --port N            ホストの SSH ポート（--hostname と一緒に使う）
#       --cloudflared       Cloudflare Tunnel 経由で接続する
#                           （ProxyCommand cloudflared access ssh --hostname %h）
#       --identity FILE     ホストとコンテナへのログインに使う秘密鍵
#       --ssh-host ALIAS    ホストの SSH 名。--hostname を使わず、既存の ~/.ssh/config の
#                           設定を使うときに指定する（既定は <id>）
#       --key FILE          コンテナに登録する公開鍵（既定: ~/.ssh/id_ed25519.pub など）
#       --work-root PATH    ホスト上の作業ディレクトリの置き場（既定 ~/cubby/work）。
#                           各コンテナの作業ディレクトリは <置き場>/<名前> に作られる
#       --rebuild           コンテナイメージを作り直す
#       --no-gpu            GPU の準備（NVIDIA Container Toolkit の導入など）をしない
#       --mount SPEC        ホストの全コンテナに毎回マウントするディレクトリを足す（複数可）
#                           SPEC は ホストのパス[:コンテナ内のパス][:ro|rw]（省略時は同じパス・rw）
#                           例 --mount /data/datasets:/datasets:ro --mount /scratch
#       --unmount PATH      そのホストのパスのマウントをやめる（複数可）
#                           ※既存のコンテナへの反映はホストで ctr-recreate <名前>
#       --replace-hostkey   known_hosts の既存のホスト鍵と違っても置き換える
#   cubby update [id...] [--rebuild] [--mount SPEC]... [--unmount PATH]... [--replace-hostkey]
#                                   登録済みのホスト（省略時は全ホスト）を、登録時の設定のまま更新する。
#                                   最新のスクリプトを転送し、image/（Dockerfile など）が変わっていれば
#                                   イメージを自動で作り直す。マウントの追加・削除もこれで行う
#   cubby hosts                     登録済みのホストを一覧する
#   cubby list [id...]              各ホストのコンテナ・作業ディレクトリを一覧する（既定: 全ホスト）
#   cubby preflight <id>            ホストの事前確認（何も変更しない）
#   cubby remove-host [-y] <id>     手元の登録だけを消す（ホスト上のものは消さない）
#
# add-host がすること（ホスト側の事前準備は不要。`ssh <ホスト>` で入れて sudo が使えればよい）:
#   0. ホストに鍵認証で入れなければ、ログインのパスワードを 1 回だけ尋ねて、手元の公開鍵を
#      ホストの ~/.ssh/authorized_keys に追記する（sudo にも同じパスワードを試す）
#      パスワードは端末なら表示せずに尋ね、端末でなければ標準入力から 1 行読む
#   1. ~/.ssh/config の先頭に、このホスト用の管理ブロック（# >>> cubby <id> ... >>>）を書く
#   2. host/bootstrap-root.sh で root が要る準備が残っているか調べ、残っていれば sudo で実行する
#      （Podman などのパッケージ・subuid/subgid・linger・ディレクトリ。済んでいれば sudo は使わない。
#        パスワードが要る場合は手元で尋ね、sudo -S に渡す）
#   3. ホストにスクリプトを転送し、host/setup-host.sh を実行する
#      （公開鍵の登録・ホスト鍵の生成・イメージのビルド・動作確認・GPU の判定・追加マウント）
#   4. コンテナのホスト鍵を ~/.ssh/known_hosts に cubby-<id> として登録する
#      （認証済みのホストへの SSH で受け取るので、初回の確認は不要）
#
# 接続名は ctr-<作業名>.<id>（GPU なし。例 ctr-feature1.lab1）、または
# gpu-<作業名>.<id>（GPU あり。GPU が使えるホストのみ。例 gpu-train.lab1）。
# 各コンテナの作業ディレクトリは空で始まる。リポジトリの clone などはコンテナ内で行う。
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=client/cubby-lib.sh
. "$here/client/cubby-lib.sh"
REMOTE_SHARE='.local/share/cubby'
REMOTE_BIN='.local/bin'

log()  { printf 'cubby: %s\n' "$*" >&2; }
die()  { printf 'cubby: ERROR: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -eu/p' "$here/client/cubby" | grep '^#' | sed 's/^# \{0,1\}//' >&2; exit 2; }

valid_id() {
  case "$1" in ''|*[!a-z0-9-]*|-*) return 1 ;; esac
  [ "${#1}" -le 32 ]
}
no_quote() {
  case "$2" in *"'"*|*'"'*|*' '*) die "$1 must not contain quotes or spaces: $2" ;; esac
}
# ssh_config の値。空白を含むパス（例 C:/Program Files/...）は二重引用符で囲む
cfgval() {
  case "$1" in *' '*) printf '"%s"' "$1" ;; *) printf '%s' "$1" ;; esac
}
# GitHub のリポジトリの URL から owner/repo を取り出す（GitHub でなければ空）
github_slug() {
  printf '%s\n' "$1" | sed -n \
    -e 's#^git@github\.com:\([^/]*/[^/]*\)$#\1#p' \
    -e 's#^ssh://git@github\.com/\([^/]*/[^/]*\)$#\1#p' \
    -e 's#^https://github\.com/\([^/]*/[^/]*\)$#\1#p' | sed 's/\.git$//; s#/$##' | head -n 1
}

# 手元の cubby に、ホストが取得できない変更（未コミット・未 push）があれば知らせる
warn_unpushed() {
  dirty=$(git -C "$here" status --porcelain -- bin host image config.env.example 2>/dev/null | head -n 1)
  ahead=$(git -C "$here" rev-list --count "origin/$1..HEAD" 2>/dev/null || echo 0)
  if [ -n "$dirty" ] || [ "${ahead:-0}" != 0 ]; then
    log "WARNING: this cubby has uncommitted or unpushed changes; hosts with auto-update follow origin/$1, so commit and push them"
  fi
}

# デプロイキー（読み取り専用）を GitHub のリポジトリに登録する（gh が使えれば自動、なければ案内）
register_deploy_key() {
  slug=$1 pub=$2 title=$3
  body=$(printf '%s' "$pub" | cut -d' ' -f2)
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh repo deploy-key list --repo "$slug" 2>/dev/null | grep -qF "$body"; then
      log "auto-update: deploy key for this host is already registered on $slug"
      return 0
    fi
    kf=$(mktemp)
    printf '%s\n' "$pub" > "$kf"
    if gh repo deploy-key add "$(natpath "$kf")" --repo "$slug" --title "$title" >/dev/null 2>&1; then
      log "auto-update: registered a read-only deploy key on github.com/$slug (title: $title)"
      rm -f "$kf"; return 0
    fi
    rm -f "$kf"
    log "WARNING: auto-update: could not register the deploy key with gh (need admin rights on $slug?)"
  else
    log "auto-update: gh is not available or not logged in; register the deploy key yourself:"
  fi
  log "  https://github.com/$slug/settings/keys/new  (title: $title, read-only)"
  log "  $pub"
}

# 管理ブロックの「Host ctr-*...」の User（コンテナのログインユーザー）を読む
ctr_user_of() {
  awk -v id="$1" '
    index($0, "# >>> cubby " id " ssh-host=") == 1 { inb = 1; next }
    inb && $0 == "# <<< cubby " id " <<<"      { exit }
    inb && $1 == "Host"                          { inctr = ($2 ~ /^ctr-/) ; next }
    inb && inctr && $1 == "User"                 { print $2; exit }
  ' "$SSH_CONFIG" 2>/dev/null
}

alias_of() {
  a=$(cubby_alias_of "$1")
  [ -n "$a" ] || die "host '$1' is not registered (cubby add-host $1 ...)"
  printf '%s\n' "$a"
}

# ~/.ssh/config から <id> の管理ブロックを取り除いたものを標準出力に出す
config_without_block() {
  awk -v id="$1" '
    BEGIN { b = "# >>> cubby " id " ssh-host="; e = "# <<< cubby " id " <<<" }
    index($0, b) == 1 { skip = 1; next }
    skip && $0 == e   { skip = 0; eat = 1; next }
    skip              { next }
    eat && $0 == ""   { eat = 0; next }
                      { eat = 0; print }
  ' "$SSH_CONFIG"
}

# ~/.ssh/config の先頭に管理ブロックを置く（Host * より前に来るように。既存のブロックは置き換える）
write_block() {
  mkdir -p "$SSH_DIR"
  chmod 700 "$SSH_DIR" 2>/dev/null || true
  touch "$SSH_CONFIG"
  config_lock
  cp "$SSH_CONFIG" "$SSH_CONFIG.cubby.bak"
  config_without_block "$1" > "$SSH_CONFIG.cubby.tmp"
  { cat "$2"; echo; cat "$SSH_CONFIG.cubby.tmp"; } > "$SSH_CONFIG.cubby.new"
  rm -f "$SSH_CONFIG.cubby.tmp"
  chmod 600 "$SSH_CONFIG.cubby.new" 2>/dev/null || true
  replace_config "$SSH_CONFIG.cubby.new"
  config_unlock
}

# 書き換え途中の ~/.ssh/config を ssh が読まないよう、別のファイルに書いてから置き換える。
# Windows では ssh が開いている間は置き換えに失敗することがあるので、少し待って再試行する。
replace_config() {
  i=0
  until mv -f "$1" "$SSH_CONFIG" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 50 ] || { rm -f "$1"; config_unlock; die "could not replace $SSH_CONFIG (in use?)"; }
    sleep 0.1
  done
}

# ~/.ssh/config の書き換えを排他する（複数の add-host を同時に動かしても互いに上書きしない）。
# flock は macOS や Git Bash にないことがあるので、mkdir の原子性を使う。
config_lock() {
  i=0
  until mkdir "$SSH_CONFIG.cubby.lock" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 300 ] || die "timed out waiting for $SSH_CONFIG.cubby.lock (remove it if no cubby is running)"
    sleep 0.1
  done
}
config_unlock() { rmdir "$SSH_CONFIG.cubby.lock" 2>/dev/null || true; }

find_pubkeys() {
  if [ -n "$1" ]; then
    [ -r "$1" ] || die "cannot read $1"
    cat "$1"; return
  fi
  for k in id_ed25519 id_ecdsa id_rsa; do
    if [ -r "$default_ssh_dir/$k.pub" ]; then cat "$default_ssh_dir/$k.pub"; return; fi
  done
  if "$SSH_ADD_BIN" -L 2>/dev/null | grep -q '^ssh-\|^ecdsa-\|^sk-'; then
    "$SSH_ADD_BIN" -L | tr -d '\r'; return
  fi
  # 既定の名前の鍵がない: ~/.ssh/id_ed25519 を作る。
  # 秘密鍵だけがあれば、公開鍵を作り直す（既存の秘密鍵は上書きしない）。
  k="$default_ssh_dir/id_ed25519"
  mkdir -p "$default_ssh_dir"
  if [ -e "$k" ]; then
    log "creating $(natpath "$k").pub from the existing private key"
    "$SSH_KEYGEN_BIN" -y -f "$(natpath "$k")" > "$k.pub" \
      || die "could not read $(natpath "$k") (has a passphrase? then pass --identity, or add it to ssh-agent)"
    cat "$k.pub"; return
  fi
  for p in "$default_ssh_dir"/*.pub; do
    [ -r "$p" ] && [ -r "${p%.pub}" ] || continue
    log "note: you also have $(natpath "${p%.pub}"); to use it instead, rerun with --identity $(natpath "${p%.pub}")"
  done
  # パスフレーズなし: Claude Desktop は接続の途中でパスフレーズを入力できないため
  log "no SSH key found; creating $(natpath "$k") (ed25519, no passphrase, for Claude Desktop)"
  "$SSH_KEYGEN_BIN" -q -t ed25519 -N '' -C "cubby@$(hostname 2>/dev/null || echo client)" -f "$(natpath "$k")" </dev/null \
    || die "ssh-keygen failed; create a key yourself (ssh-keygen -t ed25519) and rerun"
  cat "$k.pub"
}

# パスの指定を整える: 先頭の ~ を展開し、Windows では C:\... や C:/... を Git Bash の形にする
normpath() {
  case "$1" in
    '') return ;;
    '~'|'~/'*|'~\'*) set -- "$(dirname "$default_ssh_dir")${1#\~}" ;;
  esac
  if [ "$CUBBY_OS" = windows ]; then cygpath -u "$1"; else printf '%s\n' "$1"; fi
}

# 綴りの近い既知のオプションを探す（先頭 5 文字か末尾 5 文字が同じもの）
suggest_option() {
  for o in --hostname --user --port --cloudflared --identity --ssh-host --key --work-root \
           --mount --unmount --no-gpu --rebuild --replace-hostkey; do
    a=$(printf '%s' "$1" | cut -c1-5); b=$(printf '%s' "$o" | cut -c1-5)
    c=${1#"${1%?????}"}; d=${o#"${o%?????}"}
    if [ "$a" = "$b" ] || [ "$c" = "$d" ]; then printf '%s\n' "$o"; return; fi
  done
}

# ホストに鍵認証で入れることを確かめる。入れなければ、ログインのパスワードを 1 回だけ尋ねて
# 手元の公開鍵をホストの ~/.ssh/authorized_keys に追記する（ssh-copy-id と同じ。既存の行は消さない）。
# 入力したパスワードは login_pw に残し、sudo で同じパスワードを試すのに使う。
ensure_key_auth() {
  a=$1
  log "checking ssh $a ..."
  if errs=$(rssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$a" true </dev/null 2>&1); then
    return 0
  fi
  case "$errs" in
    *'Permission denied ('*) ;;   # ssh の認証失敗（Permission denied (publickey,password).）
    *) printf '%s\n' "$errs" >&2
       die "cannot ssh to $a. Check the host name, network, and cloudflared login" ;;
  esac
  case "$errs" in
    *password*|*keyboard-interactive*) ;;
    *) printf '%s\n' "$errs" >&2
       die "$a accepts only public keys and yours is not registered there; register it once by another means" ;;
  esac

  # 登録する公開鍵（ホストへのログインに使う鍵）。種類と本体だけを使う（コメントは付け直す）
  if [ -n "$identity" ] && [ -r "$identity.pub" ]; then
    hkeys=$(cat "$identity.pub")
  else
    hkeys=$(find_pubkeys "$key")
  fi
  hkeys=$(printf '%s\n' "$hkeys" | tr -d '\r' | awk '
    ($1 ~ /^(ssh-|ecdsa-|sk-)/) && ($2 ~ /^[A-Za-z0-9+\/=]+$/) { print $1 " " $2 }')
  [ -n "$hkeys" ] || die "no usable public key to register on $a"
  qkeys=
  for k in $(printf '%s\n' "$hkeys" | tr ' ' '|'); do qkeys="$qkeys '$(printf '%s' "$k" | tr '|' ' ')'"; done

  log "key authentication to $a failed; registering your public key there (asks for the login password once)"
  read_secret "password for ${user:-your user} on $a: "
  login_pw=$secret; secret=
  askpass=$(make_askpass)
  # shellcheck disable=SC2016
  remote_cmd='umask 077; mkdir -p ~/.ssh && touch ~/.ssh/authorized_keys && n=0 && for k in '"$qkeys"'; do grep -qF "$k" ~/.ssh/authorized_keys || { printf "%s cubby\n" "$k" >> ~/.ssh/authorized_keys; n=$((n+1)); }; done; echo "added $n key(s) to ~/.ssh/authorized_keys" >&2'
  set +e
  CUBBY_ASKPASS_PW=$login_pw SSH_ASKPASS=$askpass SSH_ASKPASS_REQUIRE=force DISPLAY=${DISPLAY:-cubby:0} \
    MSYS2_ENV_CONV_EXCL='CUBBY_ASKPASS_PW;SSH_ASKPASS' \
    rssh -o StrictHostKeyChecking=accept-new -o PreferredAuthentications=keyboard-interactive,password \
         -o NumberOfPasswordPrompts=1 "$a" "$remote_cmd" </dev/null
  rc=$?
  set -e
  rm -rf "$(dirname "$askpass")" 2>/dev/null || true
  [ "$rc" = 0 ] || { login_pw=; die "could not log in to $a with the password"; }

  rssh -o BatchMode=yes "$a" true </dev/null 2>/dev/null \
    || die "registered the key on $a, but key authentication still fails (check permissions of ~ and ~/.ssh on the host, and that the key is in your ssh-agent)"
  log "registered your public key on $a; key authentication works now"
}

cmd_add_host() {
  id=${1:-}; [ $# -gt 0 ] && shift
  valid_id "$id" || die "invalid id '$id' (lowercase letters, digits and '-', up to 32 chars)"
  alias_name=$id hostname= user= port= cloudflared=0 identity= key= wt= rebuild=0 replace=0 gpu_mode=auto mount_args=
  auto=on auto_url= auto_branch= auto_interval=
  while [ $# -gt 0 ]; do
    case "$1" in
      --hostname)        hostname=$2; shift 2 ;;
      --user)            user=$2; shift 2 ;;
      --port)            port=$2; shift 2 ;;
      --cloudflared)     cloudflared=1; shift ;;
      --identity)        identity=$2; shift 2 ;;
      --ssh-host)        alias_name=$2; shift 2 ;;
      --key)             key=$2; shift 2 ;;
      --work-root)       wt=$2; shift 2 ;;
      --repo|--repo-url|--no-repo|--worktrees)
        die "$1 was removed: repositories are no longer managed by cubby (clone inside the container). Use --work-root to choose where work directories live" ;;
      --rebuild)         rebuild=1; shift ;;
      --replace-hostkey) replace=1; shift ;;
      --no-gpu)          gpu_mode=off; shift ;;
      --no-auto-update)        auto=off; shift ;;
      --auto-update-url)       auto_url=$2; shift 2 ;;
      --auto-update-branch)    auto_branch=$2; shift 2 ;;
      --auto-update-interval)  auto_interval=$2; shift 2 ;;
      --mount)           no_quote mount "$2"; mount_args="$mount_args --mount $2"; shift 2 ;;
      --unmount)         no_quote unmount "$2"; mount_args="$mount_args --unmount $2"; shift 2 ;;
      *) s=$(suggest_option "$1")
         die "unknown option: $1${s:+ (did you mean $s ?)}" ;;
    esac
  done
  identity=$(normpath "$identity")
  key=$(normpath "$key")
  no_quote identity "$identity"; no_quote key "$key"
  # cubby update が同じ設定で実行し直せるよう、登録の設定を管理ブロックに記録する
  saved_args=
  [ "$alias_name" = "$id" ] || saved_args="$saved_args --ssh-host $alias_name"
  [ -z "$hostname" ]        || saved_args="$saved_args --hostname $hostname"
  [ -z "$user" ]            || saved_args="$saved_args --user $user"
  [ -z "$port" ]            || saved_args="$saved_args --port $port"
  [ "$cloudflared" = 0 ]    || saved_args="$saved_args --cloudflared"
  [ -z "$identity" ]        || saved_args="$saved_args --identity $(natpath "$identity")"
  [ -z "$key" ]             || saved_args="$saved_args --key $(natpath "$key")"
  [ -z "$wt" ]              || saved_args="$saved_args --work-root $wt"
  [ "$gpu_mode" = auto ]    || saved_args="$saved_args --no-gpu"
  [ "$auto" = on ]          || saved_args="$saved_args --no-auto-update"
  [ -z "$auto_url" ]        || saved_args="$saved_args --auto-update-url $auto_url"
  [ -z "$auto_branch" ]     || saved_args="$saved_args --auto-update-branch $auto_branch"
  [ -z "$auto_interval" ]   || saved_args="$saved_args --auto-update-interval $auto_interval"
  for v in "auto-update-url:$auto_url" "auto-update-branch:$auto_branch" "auto-update-interval:$auto_interval"; do
    no_quote "${v%%:*}" "${v#*:}"
  done
  if [ -n "$identity" ]; then
    [ -r "$identity" ] || die "cannot read --identity $identity"
    # --key がなければ、--identity の公開鍵をコンテナにも登録する
    if [ -z "$key" ]; then
      [ -r "$identity.pub" ] || die "$identity.pub not found (needed to register the key); create it with: ssh-keygen -y -f $identity > $identity.pub"
      key="$identity.pub"
    fi
  fi
  for v in "alias:$alias_name" "hostname:$hostname" "user:$user" "port:$port" \
           "work-root:$wt"; do
    no_quote "${v%%:*}" "${v#*:}"
  done
  if [ -z "$hostname" ] && { [ -n "$user" ] || [ -n "$port" ] || [ "$cloudflared" = 1 ]; }; then
    die "--user/--port/--cloudflared need --hostname"
  fi

  # ProxyCommand のコマンドは絶対パスで書く。GUI から起動した Claude Desktop（特に macOS）は
  # PATH が最小限で、Homebrew などで入れたコマンドが見つからないため。
  proxy_ssh=$(cfgval "$(natpath "$SSH_BIN")")
  [ "$CUSTOM_DIR" = 1 ] && proxy_ssh="$proxy_ssh -F $(cfgval "$(natpath "$SSH_CONFIG")")"
  cf=
  if [ "$cloudflared" = 1 ]; then
    if cfp=$(command -v cloudflared 2>/dev/null) || cfp=$(command -v cloudflared.exe 2>/dev/null); then
      cf=$(cfgval "$(natpath "$cfp")")
    else
      cf=cloudflared
      log "WARNING: cloudflared is not in PATH; install it, then rerun add-host so the absolute path is written"
    fi
  fi

  # 1. ssh_config（~/.ssh/config の先頭の管理ブロック）。GPU の有無は最後に分かるので、
  #    いったん前回の値で書き、setup-host.sh の結果で書き直す。
  blk=$(mktemp)
  tmp=$(mktemp)
  trap 'rm -f "$blk" "$tmp" "$tmp.out"' EXIT
  gpu_state=$(cubby_gpu_of "$id")
  # コンテナのログインユーザー＝ホストのログインユーザー。最後に setup-host.sh の結果で確定する。
  # それまでは --user か、前回の管理ブロックの値を使う。
  ctr_user=${user:-$(ctr_user_of "$id")}
  gen_block > "$blk"
  write_block "$id" "$blk"
  log "updated the cubby block for $id at the top of $SSH_CONFIG (backup: $SSH_CONFIG.cubby.bak)"
  # 旧版（Include cubby/*.conf 方式）のファイルが残っていれば消す
  if [ -e "$SSH_DIR/cubby/$id.conf" ]; then
    rm -f "$SSH_DIR/cubby/$id.conf"
    log "removed old $SSH_DIR/cubby/$id.conf"
  fi
  add_host_rest
}

# ~/.ssh/config に書く管理ブロック（cmd_add_host の変数を使う）
gen_block() {
    echo "# >>> cubby $id ssh-host=$alias_name gpu=$gpu_state >>>"
    echo "# managed by cubby (cubby add-host $id). Edits inside this block are overwritten."
    echo "# cubby-args:$saved_args"
    echo "# コンテナ: ssh ctr-<作業名>.$id（GPU なし） / ssh gpu-<作業名>.$id（GPU あり。gpu=yes のホストのみ）"
    echo "Host ctr-*.$id gpu-*.$id"
    [ -n "$ctr_user" ] && echo "  User $ctr_user"
    echo "  ProxyCommand $proxy_ssh $alias_name $REMOTE_BIN/ctr-connect %n"
    echo "  HostKeyAlias cubby-$id"
    [ "$CUSTOM_DIR" = 1 ] && echo "  UserKnownHostsFile $(cfgval "$(natpath "$KNOWN_HOSTS")")"
    [ -n "$identity" ] && echo "  IdentityFile $(cfgval "$(natpath "$identity")")"
    echo "  ServerAliveInterval 30"
    if [ -n "$hostname" ]; then
      echo "# リモートホスト本体"
      echo "Host $alias_name"
      echo "  HostName $hostname"
      [ -n "$user" ] && echo "  User $user"
      [ -n "$port" ] && echo "  Port $port"
      [ -n "$identity" ] && echo "  IdentityFile $(cfgval "$(natpath "$identity")")"
      [ -n "$cf" ] && echo "  ProxyCommand $cf access ssh --hostname %h"
      echo "  ServerAliveInterval 30"
    fi
    echo "# <<< cubby $id <<<"
}

add_host_rest() {
  # ホストに鍵で入れるようにする（Cloudflare Access の初回はブラウザでのログインを求められる）
  # ホスト自体のホスト鍵は初回に自動で受け入れる（accept-new。変わっていたら止まる）
  login_pw=
  ensure_key_auth "$alias_name"

  # ホストに既に設定があれば、その値を既定にする（既存の側に従う）
  remote_conf=$(rssh "$alias_name" 'cat "${XDG_CONFIG_HOME:-$HOME/.config}/cubby/config.env" 2>/dev/null' </dev/null || true)
  # 作業ディレクトリの置き場: 指定 > ホストの設定 > 既定（ホストの ~/cubby/work。$HOME はホスト側で展開）
  eff_wt=$wt
  if [ -z "$eff_wt" ]; then
    eff_wt=$(printf '%s\n' "$remote_conf" | sed -n 's/^CTR_WORK_ROOT=//p' | tr -d '\r' | tail -n 1)
  fi
  [ -n "$eff_wt" ] || eff_wt='$HOME/cubby/work'

  # 2. root が要る準備（済んでいれば sudo は使わない）
  rssh "$alias_name" 'mkdir -p .cache/cubby && cat > .cache/cubby/bootstrap-root.sh' \
    < "$here/host/bootstrap-root.sh"
  bargs="--user \"\$(id -un)\" --work-root \"$eff_wt\" --gpu $gpu_mode"
  set +e
  rssh "$alias_name" "sh .cache/cubby/bootstrap-root.sh --check $bargs" </dev/null
  rc=$?
  set -e
  case $rc in
    0)  log "no root setup needed on $alias_name" ;;
    10)
      log "running root setup on $alias_name with sudo"
      manual="sudo sh ~/.cache/cubby/bootstrap-root.sh $bargs"
      if rssh "$alias_name" 'sudo -n true' </dev/null >/dev/null 2>&1; then
        rssh "$alias_name" "sudo -n sh .cache/cubby/bootstrap-root.sh $bargs" </dev/null \
          || die "root setup failed on $alias_name"
      else
        # パスワードは手元で尋ね、SSH の標準入力経由で sudo -S に渡す（端末の割り当てに依存しない）。
        # ログインのパスワードを入力済みなら、まずそれを試す（多くの場合 sudo と同じ）。
        sudo_pw=
        if [ -n "$login_pw" ] && printf '%s\n' "$login_pw" \
             | rssh "$alias_name" "sudo -S -p '' true" >/dev/null 2>&1; then
          sudo_pw=$login_pw
        else
          read_secret "sudo password for ${user:-your user} on $alias_name: "
          sudo_pw=$secret; secret=
          printf '%s\n' "$sudo_pw" | rssh "$alias_name" "sudo -S -p '' true" >/dev/null 2>&1 \
            || { sudo_pw=; die "sudo failed on $alias_name (wrong password, or no sudo rights). An admin can run on the host: $manual"; }
        fi
        printf '%s\n' "$sudo_pw" | rssh "$alias_name" "sudo -S -p '' sh .cache/cubby/bootstrap-root.sh $bargs" \
          || { sudo_pw=; die "root setup failed on $alias_name"; }
        sudo_pw=
      fi
      login_pw=
      ;;
    *)  die "host check failed on $alias_name" ;;
  esac

  # 3. スクリプトを転送して setup-host.sh を実行する
  log "uploading scripts to $alias_name:~/$REMOTE_SHARE"
  tar -C "$here" -cf - bin host image config.env.example \
    | rssh "$alias_name" "mkdir -p $REMOTE_SHARE && rm -rf $REMOTE_SHARE/bin $REMOTE_SHARE/host $REMOTE_SHARE/image && tar -xf - -C $REMOTE_SHARE"

  find_pubkeys "$key" > "$tmp"
  args="--id $id --pubkeys - --gpu $gpu_mode$mount_args"
  [ -z "$wt" ] || args="$args --work-root $wt"
  [ "$rebuild" = 1 ] && args="$args --rebuild"
  # 自動更新: ホストが cubby のリポジトリ（このクローンの origin）を定期的に取得して反映する
  au_url= au_slug=
  if [ "$auto" = off ]; then
    args="$args --no-auto-update"
  else
    au_url=$auto_url
    [ -n "$au_url" ] || au_url=$(git -C "$here" remote get-url origin 2>/dev/null || true)
    if [ -z "$au_url" ]; then
      log "auto-update: skipped (this cubby directory has no git remote 'origin'; pass --auto-update-url URL)"
    else
      au_slug=$(github_slug "$au_url")
      if [ -n "$au_slug" ]; then
        # GitHub: 公開リポジトリなら https で（鍵なし）、非公開ならデプロイキー付きの ssh で取得する
        if [ "$(gh repo view "$au_slug" --json visibility -q .visibility 2>/dev/null)" = PUBLIC ]; then
          au_url="https://github.com/$au_slug.git"
        else
          au_url="git@github.com:$au_slug.git"
        fi
      fi
      au_branch=${auto_branch:-$(git -C "$here" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)}
      [ "$au_branch" != HEAD ] || au_branch=main
      no_quote auto-update-url "$au_url"; no_quote auto-update-branch "$au_branch"
      args="$args --auto-update $au_url --auto-update-branch $au_branch"
      [ -z "$auto_interval" ] || args="$args --auto-update-interval $auto_interval"
      warn_unpushed "$au_branch"
    fi
  fi
  log "running setup-host.sh on $alias_name (building the image takes a few minutes when needed)"
  rssh "$alias_name" "sh $REMOTE_SHARE/host/setup-host.sh $args" < "$tmp" > "$tmp.out" \
    || die "setup-host.sh failed on $alias_name"

  # 4. known_hosts
  hostkey=$(sed -n 's/^CUBBY_HOSTKEY //p' "$tmp.out" | tr -d '\r' | head -n 1)
  case "$hostkey" in ssh-*' '*) ;; *) die "did not receive the container host key from $alias_name" ;; esac
  touch "$KNOWN_HOSTS"
  current=$(ssh-keygen -F "cubby-$id" -f "$KNOWN_HOSTS" 2>/dev/null | grep -v '^#' | awk '{print $2" "$3}' || true)
  if [ -z "$current" ]; then
    printf 'cubby-%s %s\n' "$id" "$hostkey" >> "$KNOWN_HOSTS"
    log "registered container host key as cubby-$id in $KNOWN_HOSTS"
  elif printf '%s\n' "$current" | grep -qxF "$hostkey"; then
    log "container host key cubby-$id is already registered"
  elif [ "$replace" = 1 ]; then
    ssh-keygen -R "cubby-$id" -f "$KNOWN_HOSTS" >/dev/null 2>&1
    printf 'cubby-%s %s\n' "$id" "$hostkey" >> "$KNOWN_HOSTS"
    log "replaced container host key cubby-$id in $KNOWN_HOSTS"
  else
    die "container host key for cubby-$id changed on $alias_name. If this is expected, rerun with --replace-hostkey"
  fi

  # 自動更新: デプロイキーを GitHub に登録し、最初の取得を試す
  auto_line=$(sed -n 's/^CUBBY_AUTO //p' "$tmp.out" | tr -d '\r' | head -n 1)
  if [ -n "$au_url" ]; then
    dkey=$(sed -n 's/^CUBBY_DEPLOY_KEY //p' "$tmp.out" | tr -d '\r' | head -n 1)
    if [ -n "$dkey" ] && [ -n "$au_slug" ]; then
      register_deploy_key "$au_slug" "$dkey" "cubby $id ($alias_name)"
    elif [ -n "$dkey" ]; then
      log "auto-update: add this read-only deploy key to $au_url so $alias_name can fetch it:"
      log "  $dkey"
    fi
    log "auto-update: first sync on $alias_name ..."
    if rssh "$alias_name" "$REMOTE_BIN/ctr-sync" </dev/null 2>&1 | sed 's/^/  /' >&2; then :; fi
    st=$(rssh "$alias_name" 'cat "${XDG_CONFIG_HOME:-$HOME/.config}/cubby/auto-update.state" 2>/dev/null' </dev/null | tr -d '\r')
    case "$st" in
      *' ok') log "auto-update: on ($auto_line); $alias_name follows $au_url ($au_branch)" ;;
      *) log "WARNING: auto-update: the first sync did not succeed ($st); it retries every interval. Check the deploy key / network, or run ctr-sync on the host" ;;
    esac
  elif [ "$auto" = off ]; then
    log "auto-update: off (use cubby update $id to apply changes)"
  fi

  # GPU の有無を管理ブロックに書き直す
  ru=$(sed -n 's/^CUBBY_USER //p' "$tmp.out" | tr -d '\r' | head -n 1)
  [ -n "$ru" ] && ctr_user=$ru
  gpu_line=$(sed -n 's/^CUBBY_GPU //p' "$tmp.out" | tr -d '\r' | head -n 1)
  gpu_state=${gpu_line%% *}
  case "$gpu_state" in yes|no) ;; *) gpu_state=unknown ;; esac
  gen_block > "$blk"
  write_block "$id" "$blk"
  if [ "$gpu_state" = yes ]; then
    log "GPU: available (${gpu_line#yes }); connect as gpu-<name>.$id for a GPU container"
  else
    log "GPU: not available on $id (connect as ctr-<name>.$id)"
  fi

  log "done. try: ssh ctr-test.$id hostname   (later updates: cubby update $id)"
}

# 管理ブロックに記録した登録の設定（# cubby-args:）を読む。行がなければ失敗を返す。
saved_args_of() {
  awk -v id="$1" '
    index($0, "# >>> cubby " id " ssh-host=") == 1 { inb = 1; next }
    inb && $0 == "# <<< cubby " id " <<<"      { exit 1 }
    inb && index($0, "# cubby-args:") == 1      { sub(/^# cubby-args:/, ""); print; found = 1; exit 0 }
    END { if (!found) exit 1 }
  ' "$SSH_CONFIG" 2>/dev/null
}

# cubby update [id...] [--rebuild] [--mount SPEC]... [--unmount PATH]... [--replace-hostkey]
# 登録済みのホストを、登録時の設定のまま更新する（スクリプトの転送、image/ が変わっていれば
# イメージの作り直し、鍵の追加、マウントの変更）。id を省略すると全ホスト。
cmd_update() {
  ids= extra=
  while [ $# -gt 0 ]; do
    case "$1" in
      --rebuild|--replace-hostkey) extra="$extra $1"; shift ;;
      --mount|--unmount)
        [ $# -ge 2 ] || die "$1 needs a value"
        no_quote "${1#--}" "$2"; extra="$extra $1 $2"; shift 2 ;;
      --hostname|--user|--port|--cloudflared|--identity|--ssh-host|--key|--work-root|--no-gpu)
          die "$1 is a registration setting; change it with: cubby add-host <id> ... $1 ...   (update reuses the registered settings)" ;;
      -*) s=$(suggest_option "$1")
          die "unknown option for update: $1${s:+ (did you mean $s ?)}" ;;
      *)  valid_id "$1" || die "invalid id '$1'"; ids="$ids $1"; shift ;;
    esac
  done
  [ -n "$ids" ] || ids=$(cubby_ids)
  [ -n "$ids" ] || die "no hosts registered (cubby add-host <id> ...)"
  failed=
  for id in $ids; do
    alias_of "$id" >/dev/null
    args=$(saved_args_of "$id") \
      || die "$id was registered by an older cubby; run 'cubby add-host $id ...' once with the original options"
    log "== updating $id"
    # 記録した値は引用符・空白を含まない（add-host で検証済み）ので、そのまま単語に分けてよい
    # shellcheck disable=SC2086
    ( set -f; set -- $args $extra; cmd_add_host "$id" "$@" ) || failed="$failed $id"
  done
  [ -z "$failed" ] || die "update failed for:$failed"
}

cmd_hosts() {
  ids=$(cubby_ids)
  [ -n "$ids" ] || { echo "(no hosts registered; cubby add-host <id> ...)"; return; }
  for id in $ids; do
    g=$(cubby_gpu_of "$id")
    if [ "$g" = yes ]; then conn="ctr-<name>.$id, gpu-<name>.$id"; else conn="ctr-<name>.$id"; fi
    printf '%-14s ssh-host=%-14s gpu=%-8s connect as %s\n' "$id" "$(cubby_alias_of "$id")" "$g" "$conn"
  done
}

cmd_list() {
  # shellcheck disable=SC2046
  [ $# -gt 0 ] || set -- $(cubby_ids)
  [ $# -gt 0 ] || { echo "(no hosts registered)"; return; }
  for id in "$@"; do
    a=$(alias_of "$id")
    rssh "$a" "$REMOTE_BIN/ctr-list" </dev/null || log "failed to list $id"
    echo
  done
}

cmd_preflight() {
  a=$(alias_of "${1:-}")
  rssh "$a" 'sh -s' < "$here/host/preflight.sh"
}

cmd_remove_host() {
  yes=0
  [ "${1:-}" = -y ] && { yes=1; shift; }
  id=${1:-}
  valid_id "$id" || die "invalid id '$id'"
  echo "this removes only local registration for $id:"
  echo "  the cubby block for $id in $SSH_CONFIG"
  echo "  cubby-$id in $KNOWN_HOSTS"
  echo "containers and work directories on the host are kept (use ctr-remove there)."
  if [ "$yes" = 0 ]; then
    printf 'proceed? [y/N] ' >&2
    read -r answer || answer=
    case "$answer" in y|Y|yes|YES) ;; *) log "aborted"; exit 1 ;; esac
  fi
  if [ -e "$SSH_CONFIG" ]; then
    config_lock
    cp "$SSH_CONFIG" "$SSH_CONFIG.cubby.bak"
    config_without_block "$id" > "$SSH_CONFIG.cubby.new"
    replace_config "$SSH_CONFIG.cubby.new"
    config_unlock
  fi
  rm -f "$SSH_DIR/cubby/$id.conf"
  [ -e "$KNOWN_HOSTS" ] && ssh-keygen -R "cubby-$id" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true
  log "removed local registration for $id"
}

sub=${1:-}; [ $# -gt 0 ] && shift
case "$sub" in
  add-host)    cmd_add_host "$@" ;;
  update)      cmd_update "$@" ;;
  hosts)       cmd_hosts ;;
  list)        cmd_list "$@" ;;
  preflight)   cmd_preflight "$@" ;;
  remove-host) cmd_remove_host "$@" ;;
  *)           usage ;;
esac
