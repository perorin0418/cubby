#!/bin/sh
# ctr-list : ctr-connect が管理するコンテナ・ボリュームを一覧する。
set -eu

CONF=${CTR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cubby/config.env}
if [ -r "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi
CONF_DIR=$(dirname "$CONF")
CTR_GPU_AVAILABLE=no
CTR_GPU_INFO=
if [ -r "$CONF_DIR/detected.env" ]; then
  # shellcheck disable=SC1091
  . "$CONF_DIR/detected.env"
fi
# shellcheck source=bin/ctr-common.sh
. "$(dirname "$0")/ctr-common.sh"

echo "== host: ${CTR_HOST_ID:-$(hostname)}  gpu: ${CTR_GPU_AVAILABLE}${CTR_GPU_INFO:+ ($CTR_GPU_INFO)}  docker in containers: $([ -n "${CTR_PODMAN_SOCKET:-}" ] && [ "${CTR_HOST_PODMAN:-yes}" != no ] && echo yes || echo no) =="
base=$(podman image inspect -f '{{index .Labels "cubby.base-image"}}' "${CTR_IMAGE:-localhost/ctr-dev:latest}" 2>/dev/null || true)
echo "== container OS (image base): ${base:-unknown}"
if [ -r "$CONF_DIR/auto-update.env" ]; then
  # shellcheck disable=SC1091
  au=$(. "$CONF_DIR/auto-update.env"; printf '%s (%s) every %s' "$CTR_AUTO_URL" "${CTR_AUTO_BRANCH:-main}" "${CTR_AUTO_INTERVAL:-15min}")
  st=$(cat "$CONF_DIR/auto-update.state" 2>/dev/null || echo "- - not-run-yet")
  set -- $st
  echo "== auto-update: $au; last: $(printf '%s' "$1" | cut -c1-12) at ${2:-?} -> ${3:-?}"
else
  echo "== auto-update: off"
fi
echo "== containers (label ctr.managed=true) =="
podman ps -a --filter label=ctr.managed=true \
  --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.CreatedAt}}'
echo
echo "== volumes =="
podman volume ls --format '{{.Name}}' | grep -E '^(ctr|gpu)-[a-z0-9][a-z0-9-]*-home$' || echo "(none)"
echo
echo "== extra mounts (${CTR_MOUNTS_FILE:-$CONF_DIR/mounts}) =="
specs=$(ctr_mount_specs 2>&1)
if [ -n "$specs" ]; then printf '%s\n' "$specs" | sed 's/^/  /'; else echo "  (none)"; fi
sig=$(ctr_mount_sig)
outdated=
for c in $(podman ps -a --filter label=ctr.managed=true --format '{{.Names}}'); do
  [ "$(ctr_container_sig "$c")" = "$sig" ] || outdated="$outdated $c"
done
if [ -n "$outdated" ]; then
  echo "  containers created with older mount settings:$outdated"
  echo "  (recreated automatically on the next connect when nobody is connected, or now with: ctr-recreate <name>)"
fi
oldimg=
for c in $(podman ps -a --filter label=ctr.managed=true --format '{{.Names}}'); do
  ctr_image_outdated "$c" && oldimg="$oldimg $c"
done
if [ -n "$oldimg" ]; then
  echo
  echo "== containers still using an older image:$oldimg"
  echo "   (the image was rebuilt; recreated automatically on the next connect when nobody is connected, or now with: ctr-recreate <name>)"
fi
