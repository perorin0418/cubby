#!/bin/sh
# ctr-list : ctr-connect が管理するコンテナ・ボリューム・作業ディレクトリを一覧する。
set -eu

CONF=${CTR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cubby/config.env}
if [ -r "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi
WORK_ROOT=${CTR_WORK_ROOT:-$HOME/cubby/work}
CONF_DIR=$(dirname "$CONF")
CTR_GPU_AVAILABLE=no
CTR_GPU_INFO=
if [ -r "$CONF_DIR/detected.env" ]; then
  # shellcheck disable=SC1091
  . "$CONF_DIR/detected.env"
fi
# shellcheck source=bin/ctr-common.sh
. "$(dirname "$0")/ctr-common.sh"

echo "== host: ${CTR_HOST_ID:-$(hostname)}  gpu: ${CTR_GPU_AVAILABLE}${CTR_GPU_INFO:+ ($CTR_GPU_INFO)} =="
echo "== containers (label ctr.managed=true) =="
podman ps -a --filter label=ctr.managed=true \
  --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}\t{{.CreatedAt}}'
echo
echo "== volumes =="
podman volume ls --format '{{.Name}}' | grep -E '^(ctr|gpu)-[a-z0-9][a-z0-9-]*-home$' || echo "(none)"
echo
echo "== extra mounts (${CTR_MOUNTS_FILE:-$CONF_DIR/mounts}) =="
specs=$(ctr_mount_specs 2>&1)
if [ -n "$specs" ]; then printf '%s\n' "$specs" | sed 's/^/  /'; else echo "  (none)"; fi
sig=$(ctr_mount_sig)
outdated=
for c in $(podman ps -a --filter label=ctr.managed=true --format '{{.Names}}'); do
  [ "$(ctr_container_sig "$c")" = "$sig" ] || outdated="$outdated $c"
done
if [ -n "$outdated" ]; then
  echo "  containers created with older mount settings:$outdated"
  echo "  (apply with: ctr-recreate <name>)"
fi
oldimg=
for c in $(podman ps -a --filter label=ctr.managed=true --format '{{.Names}}'); do
  ctr_image_outdated "$c" && oldimg="$oldimg $c"
done
if [ -n "$oldimg" ]; then
  echo
  echo "== containers still using an older image:$oldimg"
  echo "   (the image was rebuilt; apply with: ctr-recreate <name>)"
fi
echo
echo "== work directories ($WORK_ROOT) =="
found=0
for d in "$WORK_ROOT"/ctr-* "$WORK_ROOT"/gpu-*; do
  [ -d "$d" ] || continue
  found=1
  n=$(ls -A "$d" 2>/dev/null | wc -l | tr -d ' ')
  echo "  $d  ($n item(s))"
  # 中の git のリポジトリ（コンテナ内で clone したものなど。深さ 3 まで）
  find "$d" -maxdepth 3 -name .git 2>/dev/null | while IFS= read -r g; do
    r=$(dirname "$g")
    b=$(git -C "$r" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
    st=$(git -C "$r" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    echo "    git ${r#"$d"/} [$b] $st uncommitted"
  done
done
[ "$found" = 1 ] || echo "  (none)"
