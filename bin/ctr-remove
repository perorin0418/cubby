#!/bin/sh
# ctr-remove [-y] [--force] <name>[.<host-id>]
#
# 接続名 <name> のコンテナ・worktree・ホームのボリュームを片付ける。ブランチは消さない。
#   -y       確認を省略する
#   --force  未コミットの変更があっても worktree を消す（git worktree remove --force）
#
# 未コミットの変更がある場合は、何も消す前に止まって内容を表示する。
set -eu

CONF=${CTR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cubby/config.env}
if [ -r "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi
REPO=${CTR_REPO:-/srv/project}
WT_ROOT=${CTR_WT_ROOT:-/srv/worktrees}

log() { printf 'ctr-remove: %s\n' "$*" >&2; }
usage() { echo "usage: ctr-remove [-y] [--force] <name>" >&2; exit 2; }

yes=0
force=0
name=
for arg in "$@"; do
  case "$arg" in
    -y|--yes) yes=1 ;;
    --force)  force=1 ;;
    -*)       usage ;;
    *)        [ -z "$name" ] || usage; name=$arg ;;
  esac
done
# 接続名の .<ホストID> は取り除く（ctr-feature1.gpu1 → ctr-feature1）
name=${name%%.*}

case "$name" in
  ''|*[!a-z0-9-]*) log "invalid name: $name"; exit 2 ;;
  ctr-[a-z0-9]*)   ;;
  *)               log "invalid name: $name"; exit 2 ;;
esac
[ "${#name}" -le 44 ] || { log "name too long: $name"; exit 2; }

wt="$WT_ROOT/$name"
vol="$name-home"

has_container=0; podman container exists "$name" >/dev/null 2>&1 && has_container=1
has_volume=0;    podman volume exists "$vol" >/dev/null 2>&1 && has_volume=1
has_wt=0;        [ -e "$wt" ] && has_wt=1

if [ "$has_container$has_volume$has_wt" = 000 ]; then
  log "nothing to remove for $name"
  exit 0
fi

# 1. 対象を表示し、確認を求める
echo "remove targets for $name:"
[ "$has_container" = 1 ] && echo "  container: $name"
[ "$has_wt" = 1 ]        && echo "  worktree:  $wt"
[ "$has_volume" = 1 ]    && echo "  volume:    $vol"
echo "  (branch $name is kept)"

# 未コミットの変更があれば、何も消す前に止める（--force 指定時を除く）。
if [ "$has_wt" = 1 ] && [ "$force" = 0 ]; then
  dirty=$(git -C "$wt" status --porcelain 2>&1) || {
    log "cannot read git status of $wt:"; printf '%s\n' "$dirty" >&2; exit 1; }
  if [ -n "$dirty" ]; then
    log "worktree has uncommitted changes; nothing was removed (use --force to discard):"
    printf '%s\n' "$dirty" >&2
    exit 1
  fi
fi

if [ "$yes" = 0 ]; then
  printf 'proceed? [y/N] ' >&2
  read -r answer || answer=
  case "$answer" in
    y|Y|yes|YES) ;;
    *) log "aborted"; exit 1 ;;
  esac
fi

# 2. コンテナ
if [ "$has_container" = 1 ]; then
  podman rm -f "$name" >/dev/null
  log "removed container $name"
fi

# 3. worktree（失敗したらそこで止めて内容を表示する）
if [ "$has_wt" = 1 ]; then
  if [ "$force" = 1 ]; then
    set -- --force
  else
    set --
  fi
  if ! git -C "$REPO" worktree remove "$@" "$wt"; then
    log "git worktree remove failed; stopped. status of $wt:"
    git -C "$wt" status --short >&2 || true
    exit 1
  fi
  log "removed worktree $wt"
fi

# 4. ホームのボリューム
if [ "$has_volume" = 1 ]; then
  podman volume rm "$vol" >/dev/null
  log "removed volume $vol"
fi

# 5. ブランチは消さない
log "done (branch $name kept; delete it yourself if no longer needed)"
