#!/bin/sh
# ctr-remove [-y] [--force] <ctr|gpu>-<work>[.<host-id>]
#
# 接続名 <name> のコンテナとホームのボリューム（<name>-home）を片付ける。
#   -y       確認を省略する
#   --force  ホームの git のリポジトリに未コミットの変更や push していないコミットがあっても消す
#
# ホーム（コンテナ内で clone したリポジトリなど）に、未コミットの変更や push していない
# コミットのある git のリポジトリがあれば、何も消す前に止まって知らせる。
set -eu

CONF=${CTR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cubby/config.env}
if [ -r "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi

log() { printf 'ctr-remove: %s\n' "$*" >&2; }
usage() { echo "usage: ctr-remove [-y] [--force] <name>" >&2; exit 2; }

yes=0
force=0
name=
for arg in "$@"; do
  case "$arg" in
    -y|--yes) yes=1 ;;
    --force)  force=1 ;;
    -*)       usage ;;
    *)        [ -z "$name" ] || usage; name=$arg ;;
  esac
done
# 接続名の .<ホストID> は取り除く（ctr-feature1.lab1 → ctr-feature1）
name=${name%%.*}

case "$name" in
  ''|*[!a-z0-9-]*) log "invalid name: $name"; exit 2 ;;
  ctr-[a-z0-9]*|gpu-[a-z0-9]*) ;;
  *)               log "invalid name: $name"; exit 2 ;;
esac
[ "${#name}" -le 44 ] || { log "name too long: $name"; exit 2; }

vol="$name-home"

has_container=0; podman container exists "$name" >/dev/null 2>&1 && has_container=1
has_volume=0;    podman volume exists "$vol" >/dev/null 2>&1 && has_volume=1

if [ "$has_container$has_volume" = 00 ]; then
  log "nothing to remove for $name"
  exit 0
fi

# ホームの git のリポジトリ（深さ 3 まで。隠しディレクトリの下は見ない）のうち、
# 未コミットの変更か push していないコミットがあるものを表示する。
# コンテナ内の root が作ったファイルもあるので、podman unshare（ユーザー名前空間の root）で調べる。
git_report() {
  mp=$(podman volume inspect -f '{{.Mountpoint}}' "$vol" 2>/dev/null) || return 0
  [ -n "$mp" ] || return 0
  # shellcheck disable=SC2016
  podman unshare sh -c '
    cd "$1" 2>/dev/null || exit 0
    find . -maxdepth 4 -name .git ! -path "*/.*/*/.git" ! -path "*/.*/.git" 2>/dev/null | while IFS= read -r g; do
      r=${g%/.git}; r=${r#./}
      st=$(git -C "$r" status --porcelain 2>/dev/null | wc -l | tr -d " ")
      ahead=$(git -C "$r" rev-list --count "@{upstream}..HEAD" 2>/dev/null || echo "?")
      [ "$st" = 0 ] && [ "$ahead" = 0 ] && continue
      printf "  git ~/%s: %s uncommitted change(s), %s unpushed commit(s)\n" "$r" "$st" "$ahead"
    done' sh "$mp"
}

# 1. 対象を表示し、確認を求める
echo "remove targets for $name:"
[ "$has_container" = 1 ] && echo "  container: $name"
[ "$has_volume" = 1 ]    && echo "  volume:    $vol (home: Claude Code sessions, settings, cloned repositories)"

if [ "$has_volume" = 1 ]; then
  report=$(git_report)
  if [ -n "$report" ]; then
    if [ "$force" = 0 ]; then
      log "the home has git repositories with uncommitted or unpushed work; nothing was removed."
      log "push what you need (or use ctr-recreate to keep the home), then rerun; or use --force to delete it."
      printf '%s\n' "$report" >&2
      exit 1
    fi
    echo "  (--force) git repositories with unsaved work that will be deleted:"
    printf '%s\n' "$report"
  fi
fi

if [ "$yes" = 0 ]; then
  printf 'proceed? [y/N] ' >&2
  read -r answer || answer=
  case "$answer" in
    y|Y|yes|YES) ;;
    *) log "aborted"; exit 1 ;;
  esac
fi

# 2. コンテナ
if [ "$has_container" = 1 ]; then
  podman rm -f "$name" >/dev/null
  log "removed container $name"
fi

# 3. ホームのボリューム
if [ "$has_volume" = 1 ]; then
  podman volume rm "$vol" >/dev/null
  log "removed volume $vol"
fi

log "done"
