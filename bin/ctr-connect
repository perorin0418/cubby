#!/bin/sh
# ctr-connect <ctr|gpu>-<work>[.<host-id>]
#
# ~/.ssh/config の ProxyCommand から呼ばれる。接続名のコンテナと作業ディレクトリを用意し
# （なければ作る・止まっていれば起動する）、コンテナ内の sshd と標準入出力をつなぐ。
# rootless Podman で動かす（sudo 不要）。
#
# 接続名は ctr-<作業名>.<ホストID>（GPU なし）または gpu-<作業名>.<ホストID>（GPU あり）。
# ドット以降はホストの選択に使うだけで、コンテナ名・作業ディレクトリ名には
# ctr-<作業名> / gpu-<作業名> を使う。config.env の CTR_HOST_ID が設定されていれば、
# ホストID が一致しない接続は拒否する（接続先の取り違え防止）。
# gpu- のコンテナには CTR_GPU_ARGS（既定: NVIDIA の CDI デバイス nvidia.com/gpu=all）を付ける。
# setup-host.sh がこのホストで GPU を使えないと判定した場合（detected.env）は拒否する。
#
# 作業ディレクトリは <CTR_WORK_ROOT>/<名前>（既定 ~/cubby/work/<名前>）。中身は空で始まり、
# リポジトリの clone などはコンテナ内の Claude Code（や利用者）が行う。
# ホストと同じパスでマウントするので、ホストからも同じパスで見える。
#
# 重要: 標準出力は SSH の通信路そのもの。ログ・podman の出力は必ず標準エラー出力へ出す。
#       また、準備中のコマンドが SSH の入力を読み取らないよう、標準入力は /dev/null にする。
set -eu

CONF=${CTR_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/cubby/config.env}
if [ -r "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi
CONF_DIR=$(dirname "$CONF")
# setup-host.sh が検出した値（GPU が使えるか）。config.env の値があればそちらを優先する。
if [ -r "$CONF_DIR/detected.env" ]; then
  # shellcheck disable=SC1091
  . "$CONF_DIR/detected.env"
  [ -r "$CONF" ] && . "$CONF"
fi
WORK_ROOT=${CTR_WORK_ROOT:-$HOME/cubby/work}
IMAGE=${CTR_IMAGE:-localhost/ctr-dev:latest}
HOSTKEYS=${CTR_HOSTKEYS:-$CONF_DIR/hostkeys}
AUTHKEYS=${CTR_AUTHKEYS:-$CONF_DIR/authorized_keys}
LOCK_DIR=${CTR_LOCK_DIR:-${XDG_RUNTIME_DIR:-/tmp/cubby-$(id -u)}/cubby-locks}
HOST_ID=${CTR_HOST_ID:-}
GPU_AVAILABLE=${CTR_GPU_AVAILABLE:-no}
GPU_ARGS=${CTR_GPU_ARGS:---device nvidia.com/gpu=all}

log() { printf 'ctr-connect: %s\n' "$*" >&2; }
# shellcheck source=bin/ctr-common.sh
. "$(dirname "$0")/ctr-common.sh"

# 名前の検証は case で行う（grep は改行を含む入力を行ごとに判定するため、すり抜ける）。
# 改行やドットは [a-z0-9-] に含まれないので弾かれる。
full=${1:-}
name=${full%%.*}
case "$name" in
  ''|*[!a-z0-9-]*) log "invalid name: $full"; exit 2 ;;
  ctr-[a-z0-9]*|gpu-[a-z0-9]*) ;;
  *)               log "invalid name: $full"; exit 2 ;;
esac
[ "${#name}" -le 44 ] || { log "name too long: $name"; exit 2; }
gpu=no
case "$name" in gpu-*) gpu=yes ;; esac
if [ "$name" != "$full" ]; then
  hostpart=${full#*.}
  case "$hostpart" in
    ''|*[!a-z0-9-]*) log "invalid host id: $full"; exit 2 ;;
  esac
  if [ -n "$HOST_ID" ] && [ "$hostpart" != "$HOST_ID" ]; then
    log "host id mismatch: $hostpart (this host is $HOST_ID)"; exit 2
  fi
fi

if [ "$gpu" = yes ] && [ "$GPU_AVAILABLE" != yes ]; then
  log "this host has no usable GPU (${HOST_ID:-$(hostname)}); connect as ctr-${name#gpu-} instead, or rerun cubby add-host after installing the GPU driver"
  exit 2
fi

work="$WORK_ROOT/$name"

# 同名の同時接続でコンテナが二重に作られないよう、名前ごとに排他する。
# ロック中に起動するコマンドには必ず 9>&- を付ける。rootless Podman は conmon や
# fuse-overlayfs などの常駐プロセスを起動し、それらがロックの fd を受け継いで
# コンテナが動いている間ずっとロックを持ち続けてしまう。
mkdir -p "$LOCK_DIR"
exec 9>"$LOCK_DIR/$name.lock"
flock -w 60 9 || { log "lock timeout: $name"; exit 1; }

if [ ! -d "$work" ]; then
  log "creating work directory $work"
  mkdir -p "$work"
fi

# --userns=keep-id : ホストのログインユーザーをコンテナ内の同じ UID に対応づける。
#                    作業ディレクトリの所有者がホストと一致し、書き込みや git の所有者チェックが通る。
# --user root      : keep-id は既定の実行ユーザーをログインユーザーにするので、sshd 用に root に戻す
#                    （root といっても rootless のユーザー名前空間の中の root）。
# label=disable    : SELinux のホストで、マウント元を再ラベルせずに読み書きできるようにする。
# --uts/--network private : containers.conf でホストの名前空間が既定にされていても、
#                    ホスト名を設定でき、sshd :22 がホストの sshd と衝突しないようにする。
# 追加マウント（~/.config/cubby/mounts）。ホストにないパスは警告して飛ばす。
mount_sig=$(ctr_mount_sig)
# ホストの Podman の API ソケット（setup-host.sh が detected.env に記録）。あればコンテナの
# /var/run/docker.sock にマウントし、コンテナ内の docker CLI から別のコンテナを起動できるようにする
# （起動したコンテナはホスト上の兄弟になる）。CTR_HOST_PODMAN=no で無効。
docker=no
if [ "${CTR_HOST_PODMAN:-yes}" != no ] && [ -n "${CTR_PODMAN_SOCKET:-}" ] && [ -S "$CTR_PODMAN_SOCKET" ]; then
  docker=yes
fi

# 既存のコンテナが古ければ（イメージの作り直し・マウントの設定の変更・ソケットの有無）、
# 誰もつないでいないときに限り、作り直してから接続する（ホームと作業ディレクトリは残る）。
# 誰かがつないでいる間は作り直さない（その接続が切れてしまうため）。CTR_AUTO_RECREATE=no で無効。
if podman container exists "$name" </dev/null 9>&-; then
  why=
  ctr_image_outdated "$name" 9>&- && why="${why:+$why, }the image was rebuilt"
  [ "$(ctr_container_sig "$name" 9>&-)" = "$mount_sig" ] || why="${why:+$why, }mount settings changed"
  if [ "$docker" = yes ] && [ "$(podman container inspect -f '{{index .Config.Labels "ctr.docker"}}' "$name" </dev/null 2>/dev/null 9>&-)" != yes ]; then
    why="${why:+$why, }the host podman socket became available"
  fi
  if [ -n "$why" ]; then
    sessions=0
    if [ "$(podman container inspect -f '{{.State.Running}}' "$name" </dev/null 2>/dev/null 9>&-)" = true ]; then
      # 認証済みの SSH セッション（プロセス名 "sshd: user@notty"、OpenSSH 9.8 以降は "sshd-session: user@notty"）。
      # 待ち受けや認証前の接続（[listener]・[accepted]・[net]）は数えない
      sessions=$(podman exec "$name" sh -c 'ps -eo args= | grep -cE "^sshd(-session)?: [^ ]+@" || true' </dev/null 2>/dev/null 9>&-)
    fi
    if [ "${CTR_AUTO_RECREATE:-yes}" = no ]; then
      log "$name is outdated ($why); run 'ctr-recreate $name' on the host to apply it"
    elif [ "${sessions:-0}" -gt 0 ]; then
      log "$name is outdated ($why) but $sessions session(s) are connected; it will be recreated on a later connect when nobody is connected"
    else
      log "recreating $name ($why); home and work directory are kept"
      podman rm -f "$name" </dev/null >/dev/null 9>&-
    fi
  fi
fi
if ! podman container exists "$name" </dev/null 9>&-; then
  log "creating container $name (gpu: $gpu, docker: $docker)"
  set --
  # shellcheck disable=SC2086
  [ "$gpu" = yes ] && set -- $GPU_ARGS
  [ "$docker" = no ] || set -- "$@" -v "$CTR_PODMAN_SOCKET:/var/run/docker.sock"
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    set -- "$@" -v "$spec"
    log "mount ${spec%:*} (${spec##*:})"
  done <<EOF
$(ctr_mount_specs)
EOF
  # コンテナのユーザーはホストのログインユーザーそのもの（同じ名前・UID・GID・ホームのパス）。
  # ctr-entrypoint が起動時に /etc/passwd に登録する（--passwd=false: podman 自身の登録は使わない）。
  # ホームはコンテナごとのボリュームで、ホストのホームと同じパスにマウントする。
  podman run -d --name "$name" --hostname "$name" \
    --label ctr.managed=true --label ctr.name="$name" --label ctr.gpu="$gpu" \
    --label ctr.mounts="$mount_sig" --label ctr.docker="$docker" \
    --uts=private --network=private \
    --userns=keep-id --user root --passwd=false \
    -e CTR_USER="$(id -un)" -e CTR_UID="$(id -u)" -e CTR_GID="$(id -g)" -e CTR_HOME="$HOME" \
    -e CTR_SUDO="${CTR_SUDO:-yes}" \
    --security-opt label=disable \
    --restart unless-stopped \
    -v "$name-home:$HOME" \
    -v "$work:$work" \
    -v "$HOSTKEYS:/etc/ssh/ctr-hostkeys:ro" \
    -v "$AUTHKEYS:/etc/ssh/ctr-authorized_keys:ro" \
    "$@" \
    -w "$work" \
    "$IMAGE" </dev/null >/dev/null 9>&-
else
  # （古いかどうかは上で調べ、必要なら作り直し済み）
  if [ "$(podman container inspect -f '{{.State.Running}}' "$name" </dev/null 9>&-)" != true ]; then
    log "starting container $name"
    podman start "$name" </dev/null >/dev/null 9>&-
  fi
fi

# コンテナ内の sshd が応答するまで最大 15 秒（0.25 秒 x 60 回）待つ。
i=0
until podman exec "$name" nc -z 127.0.0.1 22 </dev/null >/dev/null 2>&1 9>&-; do
  i=$((i + 1))
  [ "$i" -ge 60 ] && { log "sshd not ready: $name"; exit 1; }
  sleep 0.25
done

# ロックを閉じてから繋ぐ。閉じ忘れるとセッション中ずっとロックを持ち、同名の 2 本目が待たされる。
exec 9>&-
exec podman exec -i "$name" nc 127.0.0.1 22
